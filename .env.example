PORT=5000
CLIENT_URL=http://localhost:4200
MONGO_URI=
JWT_SECRET=
NODE_ENV=development

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP creds used to send registration OTP emails (src/utils/mailer.js).
# Any SMTP provider works here — e.g. a Gmail account with an App Password
# (myaccount.google.com/apppasswords), or a transactional provider like
# Brevo/SendGrid/Mailgun's SMTP relay. If left blank, the OTP is printed to
# the server console instead of emailed — fine for local dev, not for prod.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BohraMart <no-reply@bohramart.com>"

# Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# NOT the same as RAZORPAY_KEY_SECRET, and NOT a URL. Generated separately in
# Razorpay Dashboard > Settings > Webhooks when you create the webhook there
# (that's where the Railway URL goes, as the endpoint the webhook points at).
# Used to HMAC-verify that incoming /api/webhooks/razorpay calls really came
# from Razorpay.
RAZORPAY_WEBHOOK_SECRET=

PLATFORM_COMMISSION_PERCENT=10

# Firebase project id (see bohraMart/src/app/app.config.ts firebaseConfig.projectId)
# — used server-side only to verify Google Sign-In ID tokens, no service
# account credentials required for that.
FIREBASE_PROJECT_ID=bohramart-6e152

# Shiprocket account login (https://app.shiprocket.in) — used to fetch an
# auth token server-side (see src/services/shiprocket.service.js), never
# exposed to the frontend.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Courier ranking strategy for courierSelection.service.js (PART 3):
#   balanced (default) — cheapest courier delivering within ~7 days
#   cheapest          — rank by rate, then delivery days, then rating
#   fastest            — rank by delivery days, then rate, then rating
SHIPROCKET_COURIER_STRATEGY=balanced
# Optional. A shared-secret string YOU choose and enter yourself in the
# Shiprocket dashboard when registering the tracking webhook (Settings >
# API > Webhooks), sent back on the `x-api-key` header of every webhook
# call. If left blank, incoming /api/webhooks/shiprocket calls are accepted
# without verifying this header.
SHIPROCKET_WEBHOOK_TOKEN=

# Fulfillment job queue (src/services/shipmentJobQueue.service.js) — retries
# each Shiprocket chain step (pickup registration, serviceability, order
# create, AWB, pickup request, label/invoice) independently on failure.
# How many times a single step is attempted before it's flagged
# needs_attention for a human (admin dashboard) to look at.
SHIPMENT_JOB_MAX_ATTEMPTS=3
# How often (ms) the in-process worker checks for due jobs. NOTE: this only
# runs while a Cloud Run instance is warm — see src/utils/scheduler.js for
# why min-instances=0 makes this not fully wall-clock-reliable on its own.
SHIPMENT_JOB_POLL_INTERVAL_MS=30000

# Seller acceptance flow (src/controllers/sellerOrderActionController.js,
# src/services/sellerResponseWindow.service.js) — how long a seller has to
# Accept/Reject a new order item before it's auto-cancelled and (if prepaid)
# flagged for refund.
SELLER_RESPONSE_WINDOW_HOURS=24
# How often (ms) the auto-cancel check runs. Same Cloud-Run-warm-instance
# caveat as SHIPMENT_JOB_POLL_INTERVAL_MS above.
SELLER_RESPONSE_CHECK_INTERVAL_MS=900000

# SMS notifications (src/services/notification.service.js,
# src/config/smsTemplates.js). SMS_PROVIDER selects the adapter:
#   console (default) — just logs, sends nothing, safe for local/dev
#   msg91 / twilio     — STUBS ONLY, not implemented (no account exists to
#                        verify the real request shape against — see the
#                        provider classes' own comments). Selecting one of
#                        these without implementing it will make every SMS
#                        send fail loudly in the logs (harmless — sends are
#                        failure-tolerant everywhere they're called from).
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
# India requires DLT-registered templates for transactional SMS — once a
# real provider is implemented, each key in smsTemplates.js needs its own
# registered template id, e.g.:
# DLT_TEMPLATE_ID_ORDER_PLACED=
# DLT_TEMPLATE_ID_ORDER_CONFIRMED=
# ...one per SMS_TEMPLATES key. Not created here since no DLT registration
# exists yet to reference.

# ---- Added for launch hardening ----
# Local development MUST use a database whose name ends in _dev or _test
# (e.g. mongodb+srv://.../bohramart_dev?...). The server refuses to start
# otherwise, so dev can never write to production data.
# NODE_ENV=production on Cloud Run only.

# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Encrypts seller Aadhaar / bank account numbers at rest. Store it in Secret
# Manager and NEVER rotate it without re-encrypting — losing it makes those
# values unrecoverable.
FIELD_ENCRYPTION_KEY=

# Required in production: Shiprocket webhook calls without this x-api-key
# header are rejected. Enter the same value in Shiprocket > Settings > API > Webhooks.
# SHIPROCKET_WEBHOOK_TOKEN=

# Optional: comma-separated emails for admin alerts (defaults to all admin users).
ADMIN_NOTIFICATION_EMAIL=
# Optional: Cloudinary folder prefix (use bohramarket-dev locally).
CLOUDINARY_FOLDER=bohramarket
# Online orders not paid within this many minutes are cancelled and restocked.
PAYMENT_WINDOW_MINUTES=60
# Comma-separated extra origins allowed by CORS (e.g. a staging frontend).
EXTRA_CORS_ORIGINS=
# Local dev seed accounts password (seed-demo-data.js).
SEED_PASSWORD=
