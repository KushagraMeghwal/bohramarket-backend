PORT=5000
CLIENT_URL=http://localhost:4200
MONGO_URI=
JWT_SECRET=
NODE_ENV=development

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# NOT the same as RAZORPAY_KEY_SECRET, and NOT a URL. Generated separately in
# Razorpay Dashboard > Settings > Webhooks when you create the webhook there
# (that's where the Railway URL goes, as the endpoint the webhook points at).
# Used to HMAC-verify that incoming /api/webhooks/razorpay calls really came
# from Razorpay.
RAZORPAY_WEBHOOK_SECRET=

PLATFORM_COMMISSION_PERCENT=10

# Firebase project id (see bohraMart/src/app/app.config.ts firebaseConfig.projectId)
# — used server-side only to verify Google Sign-In ID tokens, no service
# account credentials required for that.
FIREBASE_PROJECT_ID=bohramart-6e152
